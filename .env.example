# Local development only. Replace all three placeholders before starting.
DATABASE_URL=postgresql://eventify:eventify_local@localhost:5432/eventify?schema=public
TEST_DATABASE_URL=postgresql://eventify:eventify_local@localhost:5432/eventify_test?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
TICKET_SECRET=replace-with-a-different-32-character-secret
CSRF_SECRET=replace-with-another-32-character-secret
PORT=4000
WEB_ORIGINS=http://localhost:3000
# Use none ONLY for cross-site HTTPS frontend/API deployments; production cookies are Secure.
COOKIE_SAME_SITE=lax
# Set only if API is behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
# In production set API_INTERNAL_URL to the Express origin. Browser requests use Next's /api rewrite.
API_INTERNAL_URL=http://127.0.0.1:4000
